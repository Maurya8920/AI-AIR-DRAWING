{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ai-air-drawing-4snc.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}